   "source": [
    "# Prithvi EO-2.0 Multimodal LoRA Fine-Tuning Notebook (Google Colab GPU)\n",
    "-------------------------------------------------------------------------\n",
    "Runs **LoRA (Low-Rank Adaptation)** fine-tuning on Google Colab CUDA GPUs (T4 / V100 / A100).\n",
    "\n",
    "### Pipeline Steps:\n",
    "1. **GPU Acceleration & Dependencies Setup**\n",
    "2. **Repository & Working Directory Resolution**\n",
    "3. **Prithvi EO-2.0 LoRA Injection** ($r=16, \\alpha=16$)\n",
    "4. **CUDA Mixed Precision GPU Fine-Tuning Loop**\n",
    "5. **Checkpoint Merging & Automated Hugging Face Hub Deployment**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install Required Dependencies on Colab\n",
    "!pip install -q torch torchvision torchaudio rasterio pandas numpy huggingface_hub pydantic-settings"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Verify CUDA GPU Acceleration\n",
    "import torch\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'🚀 Running on Device: {device}')\n",
    "if torch.cuda.is_available():\n",
    "    print(f'   GPU Device Name: {torch.cuda.get_device_name(0)}')\n",
    "    print(f'   Memory Available: {torch.cuda.get_device_properties(0).total_memory / 1e9:.2f} GB')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Fix 'ModuleNotFoundError: No module named app' & Set Path\n",
    "import sys, os\n",
    "from pathlib import Path\n",
    "\n",
    "# If running inside Colab after zip extraction or git clone\n",
    "if os.path.exists('/content/ai-service'):\n",
    "    %cd /content/ai-service\n",
    "    sys.path.insert(0, '/content/ai-service')
    "elif os.path.exists('/content'):\n",
    "    sys.path.insert(0, '/content')\n",
    "else:\n",
    "    sys.path.insert(0, str(Path.cwd()))\n",
    "\n",
    "# Set Hugging Face environment variables\n",
    "os.environ['HF_MODEL_ID'] = 'kratika24076536835854/fine-tuned-prithvi-crop-intelligence'\n",
    "os.environ['HF_TOKEN'] = ''\n",
    "\n",
    "print(f'✅ Python search path updated: {sys.path[0]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Run High-Performance GPU Fine-Tuning Execution\n",
    "from app.training.train import train_model\n",
    "\n",
    "checkpoint_path = train_model(\n",
    "    train_manifest='manifests/train.csv',\n",
    "    val_manifest='manifests/val.csv',\n",
    "    epochs=5,\n",
    "    batch_size=4,\n",
    "    lr=1e-4,\n",
    "    lora_r=16,\n",
    "    lora_alpha=16.0\n",
    ")\n",
    "print(f'🎉 Fine-tuning finished! Best checkpoint: {checkpoint_path}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Upload Fine-Tuned LoRA Adapter & Merged Checkpoint to Hugging Face Hub\n",
    "from app.storage.huggingface_client import upload_model_to_huggingface\n",
    "\n",
    "print('Uploading LoRA adapter...')\n",
    "upload_model_to_huggingface('checkpoints/lora_prithvi_adapter.pth')\n",
    "\n",
    "print('Uploading merged full model weights...')\n",
    "upload_model_to_huggingface('checkpoints/fine_tuned_prithvi_multimodal.pth')\n",
    "\n",
    "print('🚀 All fine-tuned weights synced to Hugging Face Hub successfully!')"
   ]
  }
